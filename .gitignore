# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
build/
dist/
.eggs/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.cache/

# Data and outputs (not tracked — large files, generated)
data/*
outputs/*

# Exception: track the data layout README so the input contract
# travels with the repo.
!data/README.md

# Exception: track paper figure scripts (not their rendered exports)
!outputs/paper_figures/
outputs/paper_figures/*
!outputs/paper_figures/*.py
!outputs/paper_figures/README.md

# Logs and HPC artifacts
logs/
*.log
slurm-*.out
*.o[0-9]*
*.e[0-9]*

# Claude Code: ignore session data + per-user local settings.
# Track project-shared assets: subagents, hooks, project settings.json.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/settings.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

