# Data and outputs (not tracked — large files, generated)
data/*
outputs/*

# Exception: track the data layout README so the input contract
# travels with the repo.
!data/README.md

# Exception: track paper figure scripts (not their rendered exports)
!outputs/paper_figures/
outputs/paper_figures/*
!outputs/paper_figures/*.py
!outputs/paper_figures/README.md

# Logs and HPC artifacts
logs/
*.log
slurm-*.out
*.o[0-9]*
*.e[0-9]*

# Claude Code: local AI-assistant config, not part of the public release.
.claude/
CLAUDE.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

vendor/

# gstack /retro session data — local-only retrospective snapshots
.context/

# CFD patch input dossiers — raw geodata + exact coordinates, not for
# public release (restricted/on-request; see README "Data availability").
patches/

# Internal engineering-process docs — kept local, excluded from release.
docs/PRODUCTION_READINESS_PLAN.md
docs/onboarding/engineering_review.md

# Tests for the local Claude hook (AI tooling, not shipped).
tests/test_hooks/

# Vector figure source — regenerable by the docs/manuscript/figures/*.py scripts; keep PNGs tracked, not the heavy SVGs
docs/manuscript/figures/exports/*.svg
